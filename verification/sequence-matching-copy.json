    "manacher": {
      "module": "string",
      "symbol": "manacher",
      "title": "Manacher 回文半径",
      "code": "// odd[i] includes the center; even[i] is centered before i.\ntemplate <class S>\npair<vector<int>, vector<int>> manacher(const S &s)\n{\n    int n = (int)s.size();\n    vector<int> odd(n), even(n);\n    for (int i = 0, l = 0, r = -1; i < n; i++)\n    {\n        int k = i > r ? 1 : min(odd[l + r - i], r - i + 1);\n        while (i - k >= 0 && i + k < n && s[i - k] == s[i + k]) ++k;\n        odd[i] = k--;\n        if (i + k > r)\n        {\n            l = i - k;\n            r = i + k;\n        }\n    }\n    for (int i = 0, l = 0, r = -1; i < n; i++)\n    {\n        int k = i > r ? 0 : min(even[l + r - i + 1], r - i + 1);\n        while (i - k - 1 >= 0 && i + k < n && s[i - k - 1] == s[i + k]) ++k;\n        even[i] = k--;\n        if (i + k > r)\n        {\n            l = i - k - 1;\n            r = i + k;\n        }\n    }\n    return {move(odd), move(even)};\n}\n",
      "code_sha256": "d8083b3067c069945f341edce70fbb3d9a64ccf253f04b438c5154cb59e301bc",
